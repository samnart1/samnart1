---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Topbar from "../../components/Topbar.astro";

export async function getStaticPaths() {
  const posts = await getCollection("writing", (e) => !e.data.draft);
  return posts.map((p) => ({ params: { slug: p.id.replace(/\.md$/, "") }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const name = "Samuel Tettey-Nartey";
const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<Base title={`${post.data.title} — ${name}`} description={post.data.description} name={name}>
  <Topbar name={name} back={{ href: "/writing", label: "writing" }} />

  <main class="doc">
    <header class="head">
      <h1 class="ptitle">{post.data.title}</h1>
      <div class="meta">
        <time>{fmt(post.data.pubDate)}</time>
        {post.data.tags.length > 0 && <span class="dot">·</span>}
        {post.data.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </header>

    <article class="prose">
      <Content />
    </article>

    {post.data.repo && (
      <a class="repo" href={post.data.repo} target="_blank" rel="noopener">source ↗</a>
    )}
  </main>
</Base>

<style>
  .doc { max-width: 44rem; margin-inline: auto; padding: 7rem var(--space-m) var(--space-2xl); }

  .head { margin-bottom: var(--space-xl); }
  .ptitle { font-size: var(--step-3); font-weight: 700; color: var(--bright); letter-spacing: -0.02em; line-height: 1.1; }
  .meta { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-top: var(--space-s); font-family: var(--font-mono); font-size: var(--step--1); color: var(--faint); }
  .dot { opacity: 0.6; }
  .tag::before { content: "#"; opacity: 0.5; }

  /* prose — calm, readable, the article carries itself */
  .prose { font-size: var(--step-0); line-height: 1.8; color: var(--text); }
  .prose :global(p) { color: var(--muted); margin-top: var(--space-m); }
  .prose :global(strong) { color: var(--bright); font-weight: 600; }
  .prose :global(em) { color: var(--text); }
  .prose :global(a) { color: var(--green); text-decoration: underline; text-underline-offset: 2px; text-decoration-color: color-mix(in oklab, var(--green) 40%, transparent); }
  .prose :global(a:hover) { text-decoration-color: var(--green); }

  .prose :global(h2) {
    font-size: var(--step-1); font-weight: 700; color: var(--bright);
    margin-top: var(--space-xl); margin-bottom: 0; letter-spacing: -0.01em;
    padding-top: var(--space-m); border-top: 1px solid var(--line-soft, #1a1a1e);
  }
  .prose :global(h3) {
    font-size: var(--step-0); font-weight: 700; color: var(--text);
    margin-top: var(--space-l); font-family: var(--font-mono);
  }

  /* inline code */
  .prose :global(:not(pre) > code) {
    font-family: var(--font-mono); font-size: 0.88em;
    background: var(--bg-2); color: var(--green);
    padding: 0.1rem 0.35rem; border-radius: 5px;
    border: 1px solid var(--line-soft, #1a1a1e);
  }

  /* code blocks (Shiki) */
  .prose :global(pre) {
    margin-top: var(--space-m);
    padding: var(--space-m);
    border-radius: 10px;
    border: 1px solid var(--line);
    overflow-x: auto;
    font-size: var(--step--1); line-height: 1.6;
  }
  .prose :global(pre code) { font-family: var(--font-mono); background: none; padding: 0; border: 0; }

  .repo {
    display: inline-block; margin-top: var(--space-xl);
    font-family: var(--font-mono); font-size: var(--step--1); color: var(--green);
  }
  .repo:hover { text-decoration: underline; text-underline-offset: 3px; }
</style>
