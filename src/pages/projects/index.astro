---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Topbar from "../../components/Topbar.astro";

const name = "Samuel Tettey-Nartey";

const projects = (await getCollection("projects", (e) => !e.data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const rendered = await Promise.all(
  projects.map(async (e) => ({ data: e.data, Content: (await render(e)).Content }))
);

function primaryLink(d: Record<string, any>) {
  if (d.page) return { label: "more", href: d.page, ext: false };
  if (d.demo) return { label: "live", href: d.demo, ext: true };
  if (d.appStore) return { label: "app store", href: d.appStore, ext: true };
  if (d.playStore) return { label: "play store", href: d.playStore, ext: true };
  if (d.repo) return { label: "github", href: d.repo, ext: true };
  return null;
}
---

<Base title={`Projects — ${name}`} description="Things I've built." name={name}>
  <Topbar name={name} back={{ href: "/#projects", label: "projects" }} />

  <main class="doc">
    <h1 class="ptitle"># projects</h1>

    <ul class="list" role="list">
      {rendered.map(({ data, Content }) => {
        const link = primaryLink(data);
        return (
          <li class="item">
            <div class="item__row">
              <h2 class="item__name">
                {link
                  ? <a href={link.href} target={link.ext ? "_blank" : undefined} rel={link.ext ? "noopener" : undefined}>{data.name}</a>
                  : data.name}
              </h2>
              {link && (
                <a class="item__link" href={link.href} target={link.ext ? "_blank" : undefined} rel={link.ext ? "noopener" : undefined}>
                  {link.label}{link.ext ? " ↗" : " →"}
                </a>
              )}
              {!link && data.private && <span class="item__link item__link--muted">private</span>}
            </div>
            <div class="item__desc"><Content /></div>
            <p class="item__stack">{data.stack.join(" · ")}</p>
          </li>
        );
      })}
    </ul>
  </main>
</Base>

<style>
  .doc {
    max-width: 40rem; margin-inline: auto;
    padding: 7rem var(--space-m) var(--space-2xl);
  }
  .ptitle {
    font-family: var(--font-pixel); font-size: var(--step-2);
    color: var(--acc-projects); font-weight: 500; margin-bottom: var(--space-xl);
  }

  .list { display: flex; flex-direction: column; gap: var(--space-l); }
  .item__row { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-s); }
  .item__name { font-size: var(--step-1); font-weight: 700; color: var(--bright); letter-spacing: -0.01em; }
  .item__name a { color: var(--bright); }
  .item__name a:hover { color: var(--acc-projects); text-decoration: none; }
  .item__link {
    flex: none; font-family: var(--font-mono); font-size: var(--step--1);
    color: var(--muted); white-space: nowrap; transition: color var(--dur-fast);
  }
  .item__link:hover { color: var(--acc-projects); text-decoration: none; }
  .item__link--muted { color: var(--faint); }
  .item__desc { margin-top: var(--space-3xs); }
  .item__desc :global(p) { color: var(--muted); font-size: var(--step-0); line-height: 1.6; }
  .item__stack {
    font-family: var(--font-mono); font-size: 0.72rem;
    color: var(--faint); margin-top: var(--space-2xs); letter-spacing: -0.01em;
  }
</style>
