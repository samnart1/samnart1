---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Topbar from "../../components/Topbar.astro";

export async function getStaticPaths() {
  const langs = await getCollection("languages");
  return langs.map((l) => ({ params: { lang: l.id.split("/")[0] }, props: { meta: l } }));
}

const { meta } = Astro.props;
const m = meta.data;
const name = "Samuel Tettey-Nartey";
const slug = meta.id.split("/")[0];

const weeks = (await getCollection("weeks", (e) => !e.data.draft && e.data.lang === slug))
  .sort((a, b) => b.data.week - a.data.week); // newest first
const weeksR = await Promise.all(
  weeks.map(async (w) => ({ data: w.data, Content: (await render(w)).Content }))
);

const totalHours = weeks.reduce((s, w) => s + (w.data.hours || 0), 0);
const allWords = weeks.flatMap((w) => w.data.words);

const LEVELS = ["A0", "A1", "A2", "B1-", "B1", "B2", "C1"];
const fi = Math.max(0, LEVELS.indexOf(m.from));
const ti = Math.max(fi + 1, LEVELS.indexOf(m.to));
const span = Math.max(1, ti - fi);
const pct = Math.min(100, Math.round((weeks.length / (span * 2)) * 100));
---

<Base title={`${m.lang} — Learning — ${name}`} description={m.tagline ?? `Learning ${m.lang}, week by week.`} name={name}>
  <Topbar name={name} back={{ href: "/learning", label: "learning" }} />

  <main class="doc" style={`--accent:${m.accent}`}>
    <header class="head">
      <span class="flag">{m.flag}</span>
      <h1 class="lname">{m.lang} <span class="native">· {m.native}</span></h1>
      {m.tagline && <p class="tag">{m.tagline}</p>}

      <div class="bar" role="img" aria-label={`${pct}% toward ${m.to}`}>
        <div class="bar__fill" style={`width:${pct}%`}></div>
      </div>
      <div class="scale">
        <span>{m.from}</span><span class="scale__now">{pct}%</span><span>{m.to}</span>
      </div>

      <ul class="stats" role="list">
        <li><b>{weeks.length}</b> weeks</li>
        <li><b>{totalHours}</b> hours</li>
        <li><b>{allWords.length}</b> words</li>
      </ul>

      {allWords.length > 0 && (
        <p class="wotd">
          <span class="wotd__label">wort des tages</span>
          <span class="wotd__word" data-words={JSON.stringify(allWords)}>{allWords[0]}</span>
        </p>
      )}
    </header>

    <ol class="log" role="list">
      {weeksR.map(({ data, Content }) => (
        <li class="week">
          <div class="week__head">
            <span class="week__no">Week {String(data.week).padStart(2, "0")}</span>
            {data.emoji && <span class="week__emoji">{data.emoji}</span>}
            {data.level && <span class="week__level">{data.level}</span>}
            {data.dates && <span class="week__dates">{data.dates}</span>}
          </div>
          <div class="week__body"><Content /></div>
          {data.words.length > 0 && (
            <p class="week__words">{data.words.map((w) => <span class="chip">{w}</span>)}</p>
          )}
        </li>
      ))}
    </ol>
  </main>
</Base>

<style>
  .doc { max-width: 44rem; margin-inline: auto; padding: 7rem var(--space-m) var(--space-2xl); }

  .head { text-align: center; }
  .flag { font-size: 3rem; line-height: 1; }
  .lname { font-family: var(--font-pixel); font-size: var(--step-2); color: var(--accent); margin-top: var(--space-2xs); font-weight: 500; }
  .native { color: var(--faint); font-family: var(--font-body); font-weight: 400; font-size: 0.7em; }
  .tag { color: var(--muted); margin-top: var(--space-2xs); }

  .bar { position: relative; height: 10px; border-radius: 999px; background: var(--bg-sunken, #060607); margin-top: var(--space-l); overflow: hidden; }
  .bar__fill { height: 100%; border-radius: 999px; background: linear-gradient(90deg, color-mix(in oklab, var(--accent) 60%, transparent), var(--accent)); transition: width 1s var(--ease-out); }
  .scale { display: flex; justify-content: space-between; margin-top: 0.4rem; font-family: var(--font-mono); font-size: var(--step--2); color: var(--faint); }
  .scale__now { color: var(--accent); }

  .stats { display: flex; justify-content: center; gap: var(--space-l); margin-top: var(--space-l); font-family: var(--font-mono); font-size: var(--step--1); color: var(--muted); }
  .stats b { color: var(--bright); font-size: var(--step-1); display: block; }
  .stats li { text-align: center; }

  .wotd { margin-top: var(--space-l); font-family: var(--font-mono); }
  .wotd__label { display: block; font-size: var(--step--2); color: var(--faint); text-transform: uppercase; letter-spacing: 0.1em; }
  .wotd__word { font-size: var(--step-2); color: var(--accent); font-weight: 600; }

  /* log */
  .log { display: flex; flex-direction: column; gap: var(--space-l); margin-top: var(--space-2xl); text-align: left; }
  .week { padding-left: var(--space-m); border-left: 2px solid color-mix(in oklab, var(--accent) 45%, var(--line)); }
  .week__head { display: flex; align-items: center; gap: var(--space-s); flex-wrap: wrap; }
  .week__no { font-family: var(--font-mono); font-size: var(--step-0); font-weight: 600; color: var(--bright); }
  .week__emoji { font-size: 1.2rem; }
  .week__level { font-family: var(--font-mono); font-size: var(--step--2); color: var(--accent); }
  .week__dates { font-family: var(--font-mono); font-size: var(--step--2); color: var(--faint); margin-left: auto; }
  .week__body { margin-top: var(--space-s); }
  .week__body :global(p) { color: var(--muted); line-height: 1.7; }
  .week__body :global(p + p) { margin-top: var(--space-s); }
  .week__words { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: var(--space-s); }
  .chip { font-family: var(--font-mono); font-size: var(--step--2); color: var(--muted); padding: 0.25rem 0.6rem; border: 1px solid var(--line); border-radius: 999px; }
</style>

<script>
  // Rotate "wort des tages" every 6s from the words logged so far.
  function initWotd() {
    const el = document.querySelector<HTMLElement>(".wotd__word");
    if (!el || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    let words: string[] = [];
    try { words = JSON.parse(el.dataset.words || "[]"); } catch {}
    if (words.length < 2) return;
    let i = 0;
    setInterval(() => {
      i = (i + 1) % words.length;
      el.style.opacity = "0";
      setTimeout(() => { el.textContent = words[i]; el.style.opacity = "1"; }, 250);
    }, 6000);
    el.style.transition = "opacity .25s ease";
  }
  initWotd();
  document.addEventListener("astro:page-load", initWotd);
</script>
