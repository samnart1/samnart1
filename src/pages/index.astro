---
import { getEntry, getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import Topbar from "../components/Topbar.astro";
import ToolIcon from "../components/ToolIcon.astro";

const p = (await getEntry("profile", "profile"))!.data;

const aboutEntry = await getEntry("about", "index");
const About = aboutEntry ? (await render(aboutEntry)).Content : null;

const experience = (await getCollection("experience", (e) => !e.data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const expR = await Promise.all(
  experience.map(async (e) => ({ data: e.data, Content: (await render(e)).Content }))
);

const education = (await getCollection("education", (e) => !e.data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const projects = (await getCollection("projects", (e) => !e.data.draft && e.data.featured)).sort(
  (a, b) => a.data.order - b.data.order
);
const projR = await Promise.all(
  projects.map(async (e) => ({ data: e.data, Content: (await render(e)).Content }))
);
const totalProjects = (await getCollection("projects", (e) => !e.data.draft)).length;

const tech = await getCollection("tech");

const description = `${p.role} in ${p.location}. ${p.tagline}. Go, Python, C++ and TypeScript, mostly on the parts of a system that break.`;

const icons = {
  github: `<path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49l-.01-1.7c-2.78.62-3.37-1.37-3.37-1.37-.46-1.18-1.11-1.5-1.11-1.5-.9-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.36-2.22-.26-4.55-1.14-4.55-5.06 0-1.12.39-2.03 1.03-2.74-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.71 1.03 1.62 1.03 2.74 0 3.93-2.34 4.79-4.57 5.05.36.32.68.94.68 1.9l-.01 2.82c0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"/>`,
  mail: `<path d="M3.5 5h17A1.5 1.5 0 0 1 22 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-17A1.5 1.5 0 0 1 2 17.5v-11A1.5 1.5 0 0 1 3.5 5Zm.7 2 7.8 5.2L19.8 7H4.2Zm15.8 1.5-7.44 4.96a1 1 0 0 1-1.12 0L4 8.5V17h16V8.5Z"/>`,
  linkedin: `<path d="M6.94 6.5a1.94 1.94 0 1 1-3.88 0 1.94 1.94 0 0 1 3.88 0ZM3.4 8.9h3.06V21H3.4V8.9Zm5.2 0h2.94v1.65h.04c.41-.78 1.42-1.6 2.92-1.6 3.12 0 3.7 2.05 3.7 4.72V21h-3.06v-5.4c0-1.29-.02-2.95-1.8-2.95-1.8 0-2.08 1.4-2.08 2.85V21H8.6V8.9Z"/>`,
  cv: `<path d="M6 2h8l6 6v14H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Zm7 2H6v16h12V9h-5V4Zm-1 6 3.5 3.5-1.4 1.4-1.1-1.1V19h-2v-5.2l-1.1 1.1-1.4-1.4L12 10Z"/>`,
};
---

<Base title={`${p.name} · Software Engineer`} description={description} name={p.name}>
  <Topbar name={p.name} home="#top" />

  <div class="deck">
    <section class="block intro" id="top">
      <div class="intro__inner">
        <div class="avatar">
          <svg class="avatar__ph" viewBox="0 0 48 48" width="100%" height="100%" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
            <circle cx="24" cy="19" r="8" fill="currentColor" />
            <path d="M8 46a16 16 0 0 1 32 0Z" fill="currentColor" />
          </svg>
        </div>

        <h1 class="name">{p.name}</h1>
        <p class="role">{p.role}</p>
        <p class="tagline">{p.tagline} · {p.location}</p>

        <div class="links">
          {p.socials.map((s) => (
            <a class="chip" href={s.href} target={s.href.startsWith("http") ? "_blank" : undefined} rel="noopener">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" set:html={icons[s.icon]} />
              {s.label}
            </a>
          ))}
          {p.cv && (
            <a class="chip" href={p.cv} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" set:html={icons.cv} />
              CV
            </a>
          )}
        </div>

        {p.availability && (
          <p class="now"><span class="now__dot" aria-hidden="true"></span>{p.availability}</p>
        )}
      </div>

      <a class="scrolldown" href="#about" aria-label="Scroll to about"><span class="blink">▾</span></a>
    </section>

    <section id="about" class="block" style="--acc:var(--acc-about)">
      <h2 class="label"># {aboutEntry?.data.heading ?? "about"}</h2>
      <div class="about">{About && <About />}</div>
    </section>

    <section id="work" class="block block--tall" style="--acc:var(--acc-work)">
      <h2 class="label"># work</h2>
      <ul class="entries" role="list">
        {expR.map(({ data, Content }) => (
          <li class="entry">
            <div class="entry__row">
              <span class="entry__name">{data.role}</span>
              <span class="entry__meta">{data.period}</span>
            </div>
            <p class="entry__org">{data.org}{data.location ? `, ${data.location}` : ""}</p>
            <div class="entry__desc"><Content /></div>
          </li>
        ))}
      </ul>
    </section>

    <section id="projects" class="block block--tall" style="--acc:var(--acc-projects)">
      <h2 class="label"># projects</h2>
      <ul class="cards" role="list">
        {projR.map(({ data, Content }) => {
          const primary = data.page
            ? { href: data.page, label: "more", external: false }
            : data.demo
              ? { href: data.demo, label: "live", external: true }
              : data.repo
                ? { href: data.repo, label: "github", external: true }
                : null;
          return (
            <li class="pcard">
              <h3 class="pcard__name">{data.name}</h3>
              <div class="pcard__desc"><Content /></div>
              <p class="pcard__stack">{data.stack.join(" · ")}</p>
              {primary && (
                <div class="pcard__links">
                  <a
                    class="plink pcard__stretch"
                    href={primary.href}
                    target={primary.external ? "_blank" : undefined}
                    rel={primary.external ? "noopener" : undefined}
                  >
                    {primary.label}<span class="arw" aria-hidden="true">{primary.external ? " ↗" : " →"}</span>
                  </a>
                </div>
              )}
            </li>
          );
        })}
      </ul>
      <a class="seeall" href="/projects">
        all projects<span class="arw" aria-hidden="true"> →</span>
      </a>
    </section>

    <section id="education" class="block" style="--acc:var(--acc-education)">
      <h2 class="label"># education</h2>
      <ul class="entries" role="list">
        {education.map((e) => (
          <li class="entry">
            <div class="entry__row">
              <span class="entry__name">{e.data.school}</span>
              {e.data.period && <span class="entry__meta">{e.data.period}</span>}
            </div>
            <p class="entry__org">{e.data.program}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="tools" class="block" style="--acc:var(--acc-tools)">
      <h2 class="label"># tools</h2>
      <ul class="tools" role="list">
        {tech.map((t) => (
          <li class="tool">
            <ToolIcon slug={t.data.slug} label={t.data.label} />
            <span class="tool__name">{t.data.label}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  /* ===== SECTIONS ===== */
  .block {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: safe center;
    text-align: center;
    padding: calc(3.75rem + var(--space-l)) var(--space-m) var(--space-l);
    border-top: 1px solid var(--line);
    scroll-margin-top: 3.75rem;
  }
  .block:first-child { border-top: 0; padding-top: 0; }
  .block--tall { justify-content: flex-start; }
  .block > * { width: 100%; }

  .label {
    font-family: var(--font-pixel);
    font-size: var(--step-1);
    color: var(--acc, var(--green));
    font-weight: 500;
    margin-bottom: var(--space-l);
  }
  .label::first-letter { color: var(--faint); }

  /* ===== HERO ===== */
  .intro { position: relative; }
  .intro__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-s);
    max-width: 34rem;
    margin-inline: auto;
  }
  .intro__inner > * { animation: rise 0.6s var(--ease-out) both; }
  .intro__inner > .avatar { animation-delay: 0.05s; }
  .intro__inner > .name { animation-delay: 0.15s; }
  .intro__inner > .role { animation-delay: 0.25s; }
  .intro__inner > .tagline { animation-delay: 0.35s; }
  .intro__inner > .links { animation-delay: 0.45s; }
  .intro__inner > .now { animation-delay: 0.55s; }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .intro__inner > * { animation: none; } }

  .avatar {
    width: 7rem; height: 7rem;
    border-radius: 999px;
    overflow: hidden;
    display: grid; place-items: center;
    background: var(--surface);
    border: 1px solid var(--line);
    margin-bottom: var(--space-2xs);
  }
  .avatar__ph { width: 100%; height: 100%; display: block; color: color-mix(in oklab, var(--green) 65%, var(--muted)); }

  .name {
    font-family: var(--font-pixel);
    font-weight: 600;
    font-size: var(--step-3);
    line-height: 1.05;
    color: var(--green);
    letter-spacing: 0.01em;
  }
  .role { font-size: var(--step-1); color: var(--bright); font-weight: 600; margin-top: calc(-1 * var(--space-2xs)); }
  .tagline { color: var(--muted); font-size: var(--step-0); max-width: 34ch; }

  .links { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2xs); margin-top: var(--space-s); }
  .chip {
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--line); border-radius: 999px;
    background: var(--bg-2); color: var(--text);
    font-size: var(--step--1); font-weight: 500;
    transition: border-color var(--dur-fast), background var(--dur-fast), color var(--dur-fast);
  }
  .chip:hover { text-decoration: none; border-color: var(--blue); background: var(--surface); color: var(--bright); }
  .chip svg { fill: currentColor; }

  .now {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .now__dot {
    width: 0.5rem; height: 0.5rem; border-radius: 999px;
    background: var(--green);
    animation: pulse 2.4s var(--ease-out) infinite;
  }
  @keyframes pulse {
    0%   { box-shadow: 0 0 0 0 color-mix(in oklab, var(--green) 55%, transparent); }
    70%  { box-shadow: 0 0 0 7px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
  @media (prefers-reduced-motion: reduce) { .now__dot { animation: none; } }

  .scrolldown { position: absolute; bottom: var(--space-l); color: var(--faint); font-size: 1.2rem; }
  .scrolldown:hover { color: var(--green); text-decoration: none; }
  .blink { animation: blink 1.3s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .blink { animation: none; } }

  /* ===== ABOUT ===== */
  .about { max-width: 60ch; margin-inline: auto; }
  .about :global(p) { color: var(--text); font-size: var(--step-1); line-height: 1.7; }
  .about :global(p + p) { margin-top: var(--space-s); color: var(--muted); }

  /* ===== TIMELINE ENTRIES ===== */
  .entries { max-width: 60rem; margin-inline: auto; display: flex; flex-direction: column; gap: var(--space-s); }
  .entry {
    position: relative;
    text-align: left;
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-l);
    border-radius: 12px;
    border: 1px solid transparent;
    transition: background var(--dur-fast), border-color var(--dur-fast);
  }
  .entry::before {
    content: ""; position: absolute; left: 0.75rem; top: 1.4rem; bottom: 1.4rem;
    width: 2px; border-radius: 2px; background: var(--line);
    transition: background var(--dur-fast);
  }
  .entry::after {
    content: ""; position: absolute; left: calc(0.75rem - 4px); top: 1.4rem;
    width: 10px; height: 10px; border-radius: 999px;
    background: var(--bg); border: 2px solid var(--faint);
    transition: border-color var(--dur-fast), background var(--dur-fast);
  }
  .entry:hover { background: var(--bg-2); border-color: var(--line); }
  .entry:hover::before { background: var(--acc, var(--green)); }
  .entry:hover::after { border-color: var(--acc, var(--green)); background: var(--bg-2); }

  .entry__row { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-s); flex-wrap: wrap; }
  .entry__name { font-size: var(--step-1); font-weight: 700; color: var(--bright); }
  .entry__meta {
    font-family: var(--font-mono); font-size: var(--step--1); color: var(--faint);
    padding: 0.2rem 0.6rem; border: 1px solid var(--line); border-radius: 999px; white-space: nowrap;
  }
  .entry__org { color: var(--muted); font-size: var(--step--1); margin-top: 0.25rem; }
  .entry__desc { margin-top: var(--space-2xs); }
  .entry__desc :global(p) { color: var(--muted); font-size: var(--step--1); max-width: 78ch; line-height: 1.6; }

  /* ===== PROJECT CARDS ===== */
  .seeall {
    display: inline-flex; align-items: center; gap: 0.4rem;
    margin-top: var(--space-l);
    font-family: var(--font-mono); font-size: var(--step--1);
    color: var(--acc-projects); font-weight: 600;
  }
  .seeall:hover { text-decoration: underline; text-underline-offset: 3px; }
  .seeall .arw { transition: transform var(--dur-fast); }
  .seeall:hover .arw { transform: translateX(3px); }
  .cards {
    max-width: 60rem; margin-inline: auto;
    display: grid; grid-template-columns: 1fr; gap: var(--space-s);
  }
  @media (min-width: 40rem) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 60rem) { .cards { grid-template-columns: repeat(3, 1fr); } }

  .pcard {
    position: relative;
    display: flex; flex-direction: column; gap: var(--space-2xs);
    text-align: left;
    padding: var(--space-m);
    border: 1px solid var(--line); border-radius: 14px;
    background: var(--bg-2);
    transition: border-color var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
  }
  .pcard:hover { border-color: var(--acc, var(--green)); transform: translateY(-3px); }
  .pcard__name { font-size: var(--step-1); font-weight: 700; color: var(--bright); }
  .pcard__desc :global(p) { color: var(--muted); font-size: var(--step-0); line-height: 1.6; }
  .pcard__stack { font-family: var(--font-mono); font-size: 0.72rem; color: var(--faint); margin-top: var(--space-2xs); }
  .pcard__links { display: flex; gap: var(--space-s); margin-top: auto; padding-top: var(--space-s); }
  .plink {
    display: inline-flex; align-items: center; gap: 0.3rem;
    font-family: var(--font-mono); font-size: var(--step--1); font-weight: 500;
    color: var(--acc, var(--green));
    transition: color var(--dur-fast);
  }
  .plink:hover { text-decoration: underline; text-underline-offset: 3px; }
  .plink .arw { font-size: 0.85em; }
  .pcard__stretch::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  .pcard__links .plink:not(.pcard__stretch) { position: relative; z-index: 2; }
  @media (hover: none) { .pcard:hover { transform: none; } }

  /* ===== TOOLS ===== */
  .tools {
    max-width: 64rem; margin-inline: auto;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
    gap: var(--space-s);
  }
  .tool {
    display: flex; align-items: center; gap: 0.7rem;
    text-align: left;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line); border-radius: 12px; background: var(--bg-2);
    transition: border-color var(--dur-fast), background var(--dur-fast), transform var(--dur-fast);
  }
  .tool:hover { border-color: var(--acc, var(--green)); background: var(--surface); transform: translateY(-2px); }
  .tool:hover :global(.ticon) { color: var(--bright); }
  .tool__name { font-size: var(--step-0); color: var(--text); font-weight: 500; }
  @media (hover: none) { .tool:hover { transform: none; } }

  /* ===== SMALL SCREENS ===== */
  @media (max-width: 48rem) {
    .block { min-height: auto; padding: calc(3.5rem + var(--space-l)) var(--space-s) var(--space-xl); }
    .block:first-child { min-height: 100svh; padding-top: 0; }
    .name { font-size: clamp(1.6rem, 8vw, 2.4rem); line-height: 1.1; word-break: break-word; }
    .avatar { width: 5.5rem; height: 5.5rem; }
    .tagline { font-size: var(--step--1); }
    .now { font-size: var(--step--2); }
    .label { font-size: var(--step-0); }
    .entry { padding: var(--space-s) 0 var(--space-s) var(--space-m); }
    .entry__row { flex-direction: column; align-items: flex-start; gap: 0.35rem; }
    .entry__name { font-size: var(--step-0); }
    .entry__meta { font-size: var(--step--2); }
    .cards { grid-template-columns: 1fr; max-width: 26rem; }
    .tools { grid-template-columns: repeat(2, 1fr); gap: var(--space-2xs); max-width: 26rem; }
    .tool { padding: 0.7rem 0.8rem; }
    .tool__name { font-size: var(--step--1); }
  }

  @media (max-width: 24rem) {
    .tools { grid-template-columns: 1fr; }
    .links { gap: 0.35rem; }
    .chip { padding: 0.45rem 0.7rem; font-size: var(--step--2); }
  }
</style>

<script>
  function initKeys() {
    const deck = document.querySelector<HTMLElement>(".deck");
    if (!deck || deck.dataset.keys === "1") return;
    deck.dataset.keys = "1";

    const panels = Array.from(document.querySelectorAll<HTMLElement>(".block"));
    if (!panels.length) return;
    const barH = 60;

    const currentIndex = () => {
      const mid = scrollY + innerHeight / 2;
      let best = 0;
      let bestDist = Infinity;
      panels.forEach((panel, i) => {
        const d = Math.abs(panel.offsetTop + panel.offsetHeight / 2 - mid);
        if (d < bestDist) { bestDist = d; best = i; }
      });
      return best;
    };

    const goTo = (idx: number) => {
      idx = Math.max(0, Math.min(panels.length - 1, idx));
      scrollTo({ top: Math.max(0, panels[idx].offsetTop - barH + 1), behavior: "smooth" });
    };

    addEventListener("keydown", (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const t = e.target as HTMLElement | null;
      if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
      if (e.key === "j") { e.preventDefault(); goTo(currentIndex() + 1); }
      if (e.key === "k") { e.preventDefault(); goTo(currentIndex() - 1); }
    });
  }

  initKeys();
  document.addEventListener("astro:page-load", initKeys);
</script>
