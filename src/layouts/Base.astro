---
import { ClientRouter } from "astro:transitions";
import SEO from "../components/SEO.astro";
import "../styles/global.css";

interface Props { title: string; description?: string; name?: string; }
const {
  title,
  description = "Backend and distributed systems engineer.",
  name = "Samuel Tettey-Nartey",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#16161e" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <SEO title={title} description={description} name={name} />

    {/* Self-hosted fonts. No third-party requests anywhere on the site. */}
    <link rel="preload" href="/fonts/pixelify-sans-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono-var.woff2" as="font" type="font/woff2" crossorigin />

    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <main id="main"><slot /></main>
    <style>
      .skip { position: absolute; left: -9999px; top: 0; z-index: 100; padding: .5rem 1rem; background: var(--green); color: var(--bg); }
      .skip:focus { left: 0; }
    </style>

    <script is:inline>
      // For the curious who open devtools.
      console.log(
        "%c◆ hey, you opened the console.",
        "color:#9ece6a;font-family:monospace;font-size:13px;font-weight:bold"
      );
      console.log(
        "%cif you're reading this, you're my kind of person.\nbuilt from scratch with astro. say hi → github.com/samnart1",
        "color:#a1a1aa;font-family:monospace;font-size:12px;line-height:1.6"
      );
    </script>
  </body>
</html>
