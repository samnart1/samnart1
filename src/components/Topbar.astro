---
interface Props {
  name: string;
  home?: string;
  hint?: boolean;
  back?: { href: string; label: string };
}
const { name, home = "/", hint = false, back } = Astro.props;
---

<header class="topbar">
  <a class="brand" href={home} aria-label={name}>
    <span class="brand__logo" aria-hidden="true">◆</span>
    <span class="brand__name">{name}</span>
  </a>

  {hint && (
    <span class="kbdhint" aria-hidden="true"><kbd>j</kbd><kbd>k</kbd> to navigate</span>
  )}

  {back && <a class="back" href={back.href}>{back.label}</a>}
</header>

<style>
  .topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.7rem var(--space-m);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    background: color-mix(in oklab, var(--bg) 70%, transparent);
    border-bottom: 1px solid transparent;
  }
  :global(.topbar.scrolled) { border-bottom-color: var(--line); }

  .brand { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--text); }
  .brand:hover { text-decoration: none; }
  .brand__logo { color: var(--green); font-size: 0.9rem; }
  .brand__name {
    font-family: var(--font-pixel);
    font-size: 0.95rem;
    color: var(--bright);
    letter-spacing: 0.02em;
  }

  .back {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .back:hover { color: var(--bright); }

  .kbdhint {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--step--2);
    color: var(--faint);
    font-family: var(--font-mono);
  }
  .kbdhint kbd {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--bg-2);
    color: var(--muted);
  }

  @media (max-width: 40rem) {
    .kbdhint { display: none; }
    .topbar { padding: 0.6rem var(--space-s); }
    .brand__name { font-size: 0.8rem; }
  }
</style>

<script>
  function initBar() {
    const bar = document.querySelector(".topbar");
    if (!bar) return;
    const on = () => bar.classList.toggle("scrolled", scrollY > 8);
    on();
    addEventListener("scroll", on, { passive: true });
  }
  initBar();
  document.addEventListener("astro:page-load", initBar);
</script>