---
// Interactive circuit-breaker simulator, extracted from the Tolerant thesis page.
// Self-contained: dialog + styles + script. Include once; trigger with [data-lab-open].
import { breaker, design, sms, byRate, energy, load } from "../data/tolerant";

const maxOpens = Math.max(...byRate.map((r) => r.opens));
const maxJoules = Math.max(...byRate.map((r) => r.joulesPerSuccessPct));
const simDefaults = {
  rate: 50,
  failMax: breaker.failMax,
  reset: breaker.resetTimeoutSec,
  close: breaker.successesToClose,
  speed: 20,
};
---

  <dialog class="lab" id="lab" aria-labelledby="lab-title">
    <div class="lab__bar">
      <h2 class="lab__title" id="lab-title">Breaker lab</h2>
      <div class="tabs" role="tablist" aria-label="Breaker lab views">
        <button class="tab" role="tab" id="tab-sim" aria-controls="panel-sim" aria-selected="true" type="button">Simulate</button>
        <button class="tab" role="tab" id="tab-data" aria-controls="panel-data" aria-selected="false" type="button">Measured</button>
      </div>
      <button class="lab__close" data-lab-close aria-label="Close" type="button">✕</button>
    </div>

    <div class="lab__body" id="panel-sim" role="tabpanel" aria-labelledby="tab-sim" tabindex="0">
      <div class="sim__top">
        <span class="state" data-state>closed</span>
        <span class="sim__clock" data-clock>0.0 s</span>
        <span class="sim__spacer"></span>
        <button class="btn btn--primary" data-run type="button">Run</button>
        <button class="btn" data-reset type="button">Reset</button>
      </div>

      <div class="strip" data-strip aria-hidden="true"></div>
      <p class="legend">
        <span><i class="sw sw--ok"></i>served</span>
        <span><i class="sw sw--fail"></i>failed</span>
        <span><i class="sw sw--rej"></i>rejected by breaker</span>
      </p>

      <dl class="counts">
        <div><dt>opens</dt><dd data-c="opens">0</dd></div>
        <div><dt>served</dt><dd data-c="ok">0</dd></div>
        <div><dt>failed</dt><dd data-c="failed">0</dd></div>
        <div><dt>rejected</dt><dd data-c="rejected">0</dd></div>
      </dl>

      <div class="ctrls">
        <label>
          <span>Payment failing <b data-v="rate">{simDefaults.rate}%</b></span>
          <input type="range" data-i="rate" min="0" max="100" step="5" value={simDefaults.rate} />
        </label>
        <label>
          <span>Failures to open <b data-v="failMax">{simDefaults.failMax}</b></span>
          <input type="range" data-i="failMax" min="1" max="10" step="1" value={simDefaults.failMax} />
        </label>
        <label>
          <span>Reset timeout <b data-v="reset">{simDefaults.reset} s</b></span>
          <input type="range" data-i="reset" min="5" max="60" step="5" value={simDefaults.reset} />
        </label>
        <label>
          <span>Successes to close <b data-v="close">{simDefaults.close}</b></span>
          <input type="range" data-i="close" min="1" max="5" step="1" value={simDefaults.close} />
        </label>
        <label>
          <span>Speed <b data-v="speed">{simDefaults.speed}×</b></span>
          <input type="range" data-i="speed" min="1" max="60" step="1" value={simDefaults.speed} />
        </label>
      </div>

      <p class="note" data-note></p>
    </div>

    <div class="lab__body" id="panel-data" role="tabpanel" aria-labelledby="tab-data" tabindex="0" hidden>
      <table class="fig">
        <caption>Measured per failure rate. Pick a row to load it into the simulator.</caption>
        <thead>
          <tr>
            <th scope="col">Payment failing</th>
            <th scope="col">Opens</th>
            <th scope="col">Joules per success</th>
            <th scope="col"><span class="sr-only">Load into simulator</span></th>
          </tr>
        </thead>
        <tbody>
          {byRate.map((r) => (
            <tr>
              <th scope="row">{r.rate}%</th>
              <td class="fig__bar">
                <span class="bar" style={`--w:${(r.opens / maxOpens) * 100}%`}></span>
                <b>{r.opens}</b>
              </td>
              <td class="fig__bar">
                <span
                  class="bar bar--warn"
                  style={`--w:${(r.joulesPerSuccessPct / maxJoules) * 100}%`}
                ></span>
                <b>{r.approxZero ? "~0" : `+${r.joulesPerSuccessPct}%`}</b>
              </td>
              <td>
                <button class="link" data-load={r.rate} type="button">load</button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      <dl class="meta">
        <div><dt>breaker</dt><dd>opens on {breaker.failMax} consecutive failures, {breaker.resetTimeoutSec} s reset, {breaker.successesToClose} successes to close</dd></div>
        <div><dt>load</dt><dd>{load.users} users, {load.spawnRatePerSec}/s spawn, {load.minutesPerCondition} min per condition</dd></div>
        <div><dt>energy</dt><dd>RAPL via Scaphandre, scraped every 2 s, first {load.warmupCutSec} s discarded</dd></div>
        <div><dt>power</dt><dd>flat within {energy.powerBandPct}% across {design.rounds} rounds, every interval crosses zero</dd></div>
      </dl>

      <p class="note">
        The simulator is an idealised model of the same state machine. It reproduces the
        shape of the measured curve, not the absolute numbers, because it has no network,
        no queueing and no real service behind it.
      </p>
    </div>
  </dialog>


<style is:global>
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap;
  }

  .btn {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text);
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    cursor: pointer;
    transition: border-color var(--dur-fast), color var(--dur-fast);
  }
  .btn:hover { border-color: var(--blue); color: var(--bright); }
  .btn--primary { color: var(--green); border-color: color-mix(in oklab, var(--green) 45%, var(--line)); }

  .link {
    font: inherit;
    color: var(--blue);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .link:hover { color: var(--bright); }

  .fig {
    width: 100%;
    margin-top: var(--space-m);
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  .fig caption { text-align: left; color: var(--faint); padding-bottom: var(--space-2xs); }
  .fig th, .fig td {
    text-align: left;
    padding: 0.55rem 0.75rem 0.55rem 0;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
  }
  .fig thead th { color: var(--faint); font-weight: 400; }
  .fig tbody th { color: var(--text); font-weight: 400; white-space: nowrap; }
  .fig__num { color: var(--muted); white-space: nowrap; }
  .fig__barhead { width: 40%; }
  .fig__bar { display: flex; align-items: center; gap: 0.6rem; border-bottom: 0; }
  .fig tbody tr { border-bottom: 1px solid var(--line); }
  .fig tbody tr td { border-bottom: 0; }
  .fig tbody tr th { border-bottom: 0; }
  .bar {
    display: block;
    height: 0.5rem;
    width: var(--w, 0%);
    min-width: 2px;
    border-radius: 999px;
    background: var(--acc-projects);
    flex: none;
    max-width: 8rem;
  }
  .bar--warn { background: var(--acc-work); }
  .fig__bar b { color: var(--bright); font-weight: 400; white-space: nowrap; }

  .lab {
    margin: auto;
    width: min(46rem, calc(100vw - 2rem));
    max-height: min(46rem, calc(100vh - 2rem));
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg-2);
    color: var(--text);
    overflow: hidden;
  }
  .lab::backdrop { background: color-mix(in oklab, #000 70%, transparent); }
  .lab__bar {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    padding: var(--space-s) var(--space-m);
    border-bottom: 1px solid var(--line);
  }
  .lab__title {
    font-family: var(--font-pixel);
    font-size: var(--step-0);
    color: var(--green);
    margin-right: auto;
  }
  .tabs { display: flex; gap: 0.25rem; }
  .tab {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
    background: none;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    cursor: pointer;
  }
  .tab[aria-selected="true"] { color: var(--bright); border-color: var(--line); background: var(--surface); }
  .lab__close {
    font-size: 0.9rem;
    color: var(--muted);
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0.25rem;
  }
  .lab__close:hover { color: var(--bright); }
  .lab__body {
    padding: var(--space-m);
    overflow-y: auto;
    max-height: calc(min(46rem, 100vh - 2rem) - 4rem);
  }

  .sim__top { display: flex; align-items: center; gap: var(--space-2xs); }
  .sim__spacer { flex: 1; }
  .sim__clock { font-family: var(--font-mono); font-size: var(--step--1); color: var(--faint); }
  .state {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--green);
  }
  .state[data-phase="open"] { color: var(--acc-education); border-color: color-mix(in oklab, var(--acc-education) 45%, var(--line)); }
  .state[data-phase="half"] { color: var(--acc-work); border-color: color-mix(in oklab, var(--acc-work) 45%, var(--line)); }

  .strip {
    display: flex;
    gap: 2px;
    align-items: flex-end;
    height: 3.5rem;
    margin-top: var(--space-s);
    padding: 0.4rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
    overflow: hidden;
  }
  .strip i { display: block; flex: 1 1 0; min-width: 2px; border-radius: 1px; background: var(--line); height: 30%; }
  .strip i.ok { background: var(--green); height: 100%; }
  .strip i.fail { background: var(--acc-education); height: 60%; }
  .strip i.rej { background: var(--acc-work); height: 45%; }

  .legend { display: flex; gap: var(--space-s); flex-wrap: wrap; margin-top: var(--space-2xs); font-family: var(--font-mono); font-size: var(--step--2); color: var(--faint); }
  .legend span { display: inline-flex; align-items: center; gap: 0.35rem; }
  .sw { width: 0.6rem; height: 0.6rem; border-radius: 2px; display: block; }
  .sw--ok { background: var(--green); }
  .sw--fail { background: var(--acc-education); }
  .sw--rej { background: var(--acc-work); }

  .counts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-s);
    margin-top: var(--space-m);
  }
  .counts dt { font-family: var(--font-mono); font-size: var(--step--2); color: var(--faint); }
  .counts dd { font-family: var(--font-mono); font-size: var(--step-1); color: var(--bright); margin-top: 0.15rem; }

  .ctrls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-s);
    margin-top: var(--space-m);
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
  }
  .ctrls label { display: block; font-family: var(--font-mono); font-size: var(--step--2); color: var(--muted); }
  .ctrls label b { color: var(--bright); font-weight: 400; }
  .ctrls input[type="range"] { width: 100%; margin-top: 0.35rem; accent-color: var(--green); }

  .note {
    margin-top: var(--space-m);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--muted);
    line-height: 1.6;
  }

  .meta { margin-top: var(--space-m); display: grid; gap: var(--space-2xs); }
  .meta div { display: grid; grid-template-columns: 6rem 1fr; gap: var(--space-s); }
  .meta dt { font-family: var(--font-mono); font-size: var(--step--2); color: var(--faint); }
  .meta dd { font-size: var(--step--1); color: var(--text); }

  @media (max-width: 40rem) {
    .counts { grid-template-columns: repeat(2, 1fr); }
    .lab__bar { flex-wrap: wrap; }
    .meta div { grid-template-columns: 1fr; gap: 0; }
  }

</style>
<script>
  const RPS = 20;
  const STRIP = 90;

  interface Cfg { rate: number; failMax: number; reset: number; close: number; speed: number; }
  type Phase = "closed" | "open" | "half";

  function initLab() {
    const dialog = document.getElementById("lab") as HTMLDialogElement | null;
    if (!dialog || dialog.dataset.ready === "1") return;
    dialog.dataset.ready = "1";

    const cfg: Cfg = { rate: 50, failMax: 5, reset: 30, close: 2, speed: 25 };

    let phase: Phase = "closed";
    let t = 0;
    let openedAt = 0;
    let consecFail = 0;
    let consecOk = 0;
    let opens = 0;
    let ok = 0;
    let failed = 0;
    let rejected = 0;
    let carry = 0;
    let running = false;
    let raf = 0;
    let last = 0;

    const strip = dialog.querySelector("[data-strip]") as HTMLElement;
    const cells: HTMLElement[] = [];
    for (let i = 0; i < STRIP; i++) {
      const el = document.createElement("i");
      strip.appendChild(el);
      cells.push(el);
    }
    let head = 0;

    const stateEl = dialog.querySelector("[data-state]") as HTMLElement;
    const clockEl = dialog.querySelector("[data-clock]") as HTMLElement;
    const noteEl = dialog.querySelector("[data-note]") as HTMLElement;
    const runBtn = dialog.querySelector("[data-run]") as HTMLButtonElement;
    const counters: Record<string, HTMLElement> = {};
    dialog.querySelectorAll<HTMLElement>("[data-c]").forEach((el) => {
      counters[el.dataset.c as string] = el;
    });

    function push(kind: "ok" | "fail" | "rej") {
      const cell = cells[head % STRIP];
      cell.className = kind;
      head++;
    }

    function reset() {
      phase = "closed";
      t = 0; openedAt = 0; consecFail = 0; consecOk = 0;
      opens = 0; ok = 0; failed = 0; rejected = 0; carry = 0;
      cells.forEach((c) => (c.className = ""));
      head = 0;
      render();
    }

    function step(dt: number) {
      t += dt;
      if (phase === "open" && t - openedAt >= cfg.reset) {
        phase = "half";
        consecOk = 0;
      }

      carry += RPS * dt;
      let n = Math.min(Math.floor(carry), 80);
      carry -= n;

      const p = cfg.rate / 100;
      while (n-- > 0) {
        if (phase === "open") { rejected++; push("rej"); continue; }
        const isFail = Math.random() < p;
        if (isFail) {
          failed++; push("fail");
          if (phase === "half") { phase = "open"; openedAt = t; opens++; consecFail = 0; }
          else {
            consecFail++;
            if (consecFail >= cfg.failMax) { phase = "open"; openedAt = t; opens++; consecFail = 0; }
          }
        } else {
          ok++; push("ok");
          if (phase === "half") {
            consecOk++;
            if (consecOk >= cfg.close) { phase = "closed"; consecFail = 0; }
          } else consecFail = 0;
        }
      }
    }

    function render() {
      stateEl.textContent = phase === "half" ? "half open" : phase;
      stateEl.dataset.phase = phase;
      clockEl.textContent = `${t.toFixed(1)} s`;
      counters.opens.textContent = String(opens);
      counters.ok.textContent = ok.toLocaleString("en-GB");
      counters.failed.textContent = failed.toLocaleString("en-GB");
      counters.rejected.textContent = rejected.toLocaleString("en-GB");

      const p = cfg.rate / 100;
      const trip = Math.pow(p, cfg.failMax) * 100;
      const tripText = trip === 0 ? "never" : trip < 1 ? `${trip.toFixed(3)}%` : `${trip.toFixed(1)}%`;
      let ceiling = "no opens at this rate";
      if (p > 0) {
        const cycle = cfg.reset + cfg.failMax / (RPS * p);
        ceiling = `${Math.floor(1800 / cycle)} opens in a 30 minute run`;
      }
      noteEl.textContent =
        `Any ${cfg.failMax} requests in a row all fail ${tripText} of the time, ` +
        `so the ceiling is ${ceiling}.`;
    }

    function frame(now: number) {
      if (!running) return;
      const dtReal = Math.min((now - last) / 1000, 0.1);
      last = now;
      step(dtReal * cfg.speed);
      render();
      raf = requestAnimationFrame(frame);
    }

    function setRunning(on: boolean) {
      running = on;
      runBtn.textContent = on ? "Pause" : "Run";
      if (on) { last = performance.now(); raf = requestAnimationFrame(frame); }
      else cancelAnimationFrame(raf);
    }

    runBtn.addEventListener("click", () => setRunning(!running));
    dialog.querySelector("[data-reset]")!.addEventListener("click", () => {
      setRunning(false);
      reset();
    });

    dialog.querySelectorAll<HTMLInputElement>("[data-i]").forEach((input) => {
      const key = input.dataset.i as keyof Cfg;
      const out = dialog.querySelector(`[data-v="${key}"]`) as HTMLElement;
      const paint = () => {
        cfg[key] = Number(input.value);
        out.textContent =
          key === "rate" ? `${input.value}%`
          : key === "reset" ? `${input.value} s`
          : key === "speed" ? `${input.value}×`
          : input.value;
        render();
      };
      input.addEventListener("input", paint);
      paint();
    });

    const tabs = Array.from(dialog.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    function showTab(id: string) {
      tabs.forEach((tab) => {
        const on = tab.id === `tab-${id}`;
        tab.setAttribute("aria-selected", String(on));
        const panel = document.getElementById(tab.getAttribute("aria-controls")!)!;
        panel.hidden = !on;
      });
    }
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => showTab(tab.id.replace("tab-", "")));
    });

    dialog.querySelectorAll<HTMLButtonElement>("[data-load]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const input = dialog.querySelector('[data-i="rate"]') as HTMLInputElement;
        input.value = btn.dataset.load!;
        input.dispatchEvent(new Event("input"));
        setRunning(false);
        reset();
        showTab("sim");
      });
    });

    document.querySelectorAll<HTMLButtonElement>("[data-lab-open]").forEach((btn) => {
      btn.addEventListener("click", () => {
        showTab(btn.dataset.labTab || "sim");
        dialog.showModal();
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) setRunning(true);
      });
    });
    dialog.querySelector("[data-lab-close]")!.addEventListener("click", () => dialog.close());
    dialog.addEventListener("close", () => setRunning(false));
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });

    reset();
  }

  initLab();
  document.addEventListener("astro:page-load", initLab);
</script>
